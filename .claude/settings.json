{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Bash(pytest *)",
      "Bash(make *)",
      "Bash(python scripts/*)",
      "Bash(npm run *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git add *)",
      "Bash(git commit *)"
    ],
    "deny": [
      "Read(./data/raw/**)",
      "Read(./data/*.db)",
      "Read(./data/*.zip)",
      "Read(./.env)",
      "Bash(git push --force *)"
    ]
  }
}
